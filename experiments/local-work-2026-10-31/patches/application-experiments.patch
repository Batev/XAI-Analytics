+def harmonic_mean(x, y):
+    if x <= 0 or y <= 0:
+        return 0
+
+    return 2 * x * y / (x + y)
+
+
+def optimize_function2(
+        f: callable,
+        population: np.ndarray,
+        k_max: int,
+        w=1,
+        c1=1,
+        c2=1) \
+        -> (float, (float, float)):
+    """
+    Implementation of the PSO(Particle Swarm Optimization) algorithm for finding the optimal parameter of f that
+    produces the highest harmonic mean between csi and vsi.
+    :param f: The function to optimize. This function should take one input argument and return two output values(csi
+    and vsi):
+    float -> (float, float).
+    :param population: The search space for the input argument. This should be a one-dimensional numpy array of
+    possible input values.
+    :param k_max: The number of iterations for which the local optimizer should be applied.
+    :param w: inertia
+    :param c1: first momentum coefficient
+    :param c2: second momentum coefficient
+    :return: (global_x_best, (global_y_best_1, global_y_best_2)) A tuple containing the best input value found and a
+    tuple of the corresponding output values(result of f(x)).
+    """
+    n = population[0].x.shape[0]
+    global_x_best = population[0].x_best.copy()
+    global_y_best = (-np.inf, -np.inf)
+
+    for p in population:
+        y = f(p.x)
+
+        if harmonic_mean(y[0], y[1]) > harmonic_mean(global_y_best[0], global_y_best[1]):
+            global_x_best = p.x.copy()
+            global_y_best = y
+
+    # TODO put in separate function
+    for k in range(k_max):
+        for p in population:
+            r1 = np.random.random(n)
+            r2 = np.random.random(n)
+            p.x += p.v
+            p.v = (w * p.v) + c1 * r1 * (p.x_best - p.x) + c2 * r2 * (global_x_best - p.x)
+            y = f(p.x)
+            y_h_mean = harmonic_mean(y[0], y[1])
+            y_f_x_best = f(p.x_best)
+
+            if y_h_mean > harmonic_mean(global_y_best[0], global_y_best[1]):
+                global_x_best = p.x.copy()
+                global_y_best = y
+            if y_h_mean > harmonic_mean(y_f_x_best[0], y_f_x_best[1]):
+                p.x_best = p.x
+
+    return global_x_best, (global_y_best[0], global_y_best[1])
+
